rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin portal ──────────────────────────────────────────────────────────
    // Direct client access is restricted exclusively to the authenticated admin.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "admin@rescue.internal";
    }

    // ── Default Deny ─────────────────────────────────────────────────────────
    // Direct reads and writes from all other clients are denied by default.
    // All application transactions proceed via Cloud Functions (Admin SDK),
    // which safely bypasses client security rules.
  }
}
