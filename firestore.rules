rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin portal ──────────────────────────────────────────────────────────
    // Direct client access is permitted for any authenticated admin user.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Default Deny ─────────────────────────────────────────────────────────
    // Direct reads and writes from unauthenticated public visitors are denied.
    // Client dApp transactions proceed via Cloud Functions (Admin SDK).
  }
}
